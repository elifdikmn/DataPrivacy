# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore'da — asla commit etmeyin, GitHub'ın web
# arayüzünden asla düzenlemeyin.

# LLM (Anthropic Claude) — console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Embedding: yerel, ücretsiz sentence-transformers modeli.
# Değiştirmek istemezseniz bu satırı boş bırakabilir/silebilirsiniz,
# varsayılan olarak all-MiniLM-L6-v2 kullanılır.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Veri ve bilgi tabanı yolları (varsayılanlar backend/app/config.py içinde de tanımlı)
DATA_PATH=data/data_entries_final.json
KNOWLEDGE_DIR=knowledge
