# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore'da — asla commit etmeyin, GitHub'ın web
# arayüzünden asla düzenlemeyin.

# LLM (Anthropic Claude) — console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Frontend'in tarayıcı origin'i; Render'da yayınlanan gerçek site adresiyle değiştirin.
# Birden çok origin virgülle ayrılabilir. Sonda / kullanmayın.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# /ask istek sınırları (0 = kapalı): IP başına dakika ve gün, tüm kullanıcılar için günlük toplam.
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=100
GLOBAL_DAILY_LIMIT=500

# Embedding: yerel, ücretsiz, çok dilli sentence-transformers modeli
# (Türkçe soru + İngilizce veri terimlerini eşleştirebilmesi için).
# Değiştirmek istemezseniz bu satırı boş bırakabilir/silebilirsiniz.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Veri ve bilgi tabanı yolları (varsayılanlar backend/app/config.py içinde de tanımlı)
DATA_PATH=data/data_entries_final.json
KNOWLEDGE_DIR=knowledge
