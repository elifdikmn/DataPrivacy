# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore'da — asla commit etmeyin.

# LLM (Anthropic Claude) — console.anthropic.com üzerinden alınır
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Embedding (Together API) — api.together.ai üzerinden alınır
# Model adını Together'ın güncel embedding modelleri listesinden doğrulayın
# (bu ortamdan api.together.xyz'e erişim engelli olduğu için burada doğrulayamadım).
TOGETHER_API_KEY=
TOGETHER_EMBEDDING_MODEL=

# Veri ve bilgi tabanı yolları (varsayılanlar backend/app/config.py içinde de tanımlı)
DATA_PATH=data/data_entries_final.json
KNOWLEDGE_DIR=knowledge
